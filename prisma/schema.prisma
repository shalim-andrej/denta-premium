generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model Doctor {
  id           String    @id @default(cuid())
  name         String
  specialty    String
  description  String?
  imageUrl     String?
  experience   Int       @default(5)
  bookings     Booking[]
  schedules    Schedule[]
  createdAt    DateTime  @default(now())
}

model Schedule {
  id        String   @id @default(cuid())
  doctorId  String
  doctor    Doctor   @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  dayOfWeek Int
  startTime String
  endTime   String
}

model Service {
  id          String    @id @default(cuid())
  title       String
  category    String    @default("Терапия")
  description String?
  price       Int
  duration    Int
  isActive    Boolean   @default(true)
  bookings    Booking[]
  createdAt   DateTime  @default(now())
}

model Booking {
  id             String    @id @default(cuid())
  startTime      DateTime
  endTime        DateTime
  status         String    @default("PENDING")
  paymentStatus  String    @default("UNPAID")
  comment        String?
  paymentId      String?   // id платежа ЮKassa из вебхука — нужен для возвратов
  reminderSentAt DateTime? // когда отправлено напоминание за 24 часа
  
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  
  serviceId     String
  service       Service  @relation(fields: [serviceId], references: [id])
  
  doctorId      String
  doctor        Doctor   @relation(fields: [doctorId], references: [id])
  
  manageTokens  BookingToken[]
  createdAt     DateTime @default(now())
}

// Ссылка «управление записью»: пациент отменяет/переносит запись без звонка в клинику.
// Токен — 256 бит энтропии, угадать невозможно; доступ только по ссылке.
model BookingToken {
  id        String   @id @default(cuid())
  token     String   @unique
  bookingId String
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model User {
  id        String    @id @default(cuid())
  email     String    @unique
  name      String
  phone     String?
  role      String    @default("CLIENT")
  bookings  Booking[]
  createdAt DateTime  @default(now())
}

// Отзыв пациента. Публикуется на главной только после модерации в админке.
model Review {
  id        String   @id @default(cuid())
  name      String
  rating    Int
  text      String
  approved  Boolean  @default(false)
  createdAt DateTime @default(now())
}

// Идемпотентность вебхука ЮKassa: повторная доставка того же события
// не должна второй раз менять запись (PAID не задваивается).
model ProcessedEvent {
  id         String   @id // "<event>:<paymentId>"
  receivedAt DateTime @default(now())
}