# Скопируйте в .env и заполните своими значениями: cp .env.example .env

# База данных SQLite (создаётся командой npm run db:push)
DATABASE_URL="file:./prisma/dev.db"

# Пароль админ-панели (/login) — придумайте свой, минимум 12 символов
ADMIN_PASSWORD="change-me-strong-password"

# ЮKassa: личный кабинет → Настройки → Магазин
YOOKASSA_SHOP_ID=""
YOOKASSA_SECRET_KEY=""
