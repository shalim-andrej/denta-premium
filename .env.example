# Скопируйте в .env и заполните своими значениями: cp .env.example .env

# База данных SQLite (создаётся командой npm run db:push)
DATABASE_URL="file:./prisma/dev.db"

# Пароль админ-панели (/login) — придумайте свой, минимум 12 символов.
# Надёжнее задать хеш: npm run hash-password -- "пароль" → ADMIN_PASSWORD_HASH
ADMIN_PASSWORD="change-me-strong-password"
# ADMIN_PASSWORD_HASH="$2b$10$..."   # если задан, используется вместо ADMIN_PASSWORD

# Публичный адрес сайта (для ссылок в письмах; иначе берётся из заголовков запроса)
# NEXT_PUBLIC_SITE_URL="https://dentapremium.ru"

# ЮKassa: личный кабинет → Настройки → Магазин
YOOKASSA_SHOP_ID=""
YOOKASSA_SECRET_KEY=""

# Telegram-уведомления админу (бесплатно): @BotFather → /newbot, затем
# узнать chat_id у @userinfobot. Не заданы — уведомления отключены.
TG_BOT_TOKEN=""
TG_CHAT_ID=""

# Email-уведомления пациенту через любой SMTP (Яндекс, Mail.ru, Gmail):
# нужен «пароль приложения». Не заданы — письма не отправляются.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""

# Секрет для cron-роута напоминаний /api/cron/reminders
# (вызывать раз в час любым бесплатным планировщиком)
CRON_SECRET=""
